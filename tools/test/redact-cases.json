{
  "nota": "Casos partilhados pelos testes do filtro de redacao em Node, bash e PowerShell. 'literais' simula o valor de REPO_TOKEN.",
  "literais": ["s3cr3t-repo-token-value"],
  "casos": [
    { "in": "curl falhou com REPO_TOKEN=s3cr3t-repo-token-value", "out": "curl falhou com REPO_TOKEN=***" },
    { "in": "o valor s3cr3t-repo-token-value apareceu solto", "out": "o valor *** apareceu solto" },
    { "in": "chave sk-ant-api03-AbC_dEf-123456789 no texto", "out": "chave sk-ant-*** no texto" },
